<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" version="4.0">
<display-name>Huy Video 24162049</display-name>
<filter><filter-name>EncodingFilter</filter-name><filter-class>vn.edu.huy.filter.EncodingFilter_24162049</filter-class></filter>
<filter><filter-name>AuthenticationFilter</filter-name><filter-class>vn.edu.huy.filter.AuthenticationFilter_24162049</filter-class></filter>
<filter><filter-name>AdminAuthorizationFilter</filter-name><filter-class>vn.edu.huy.filter.AdminAuthorizationFilter_24162049</filter-class></filter>
<filter><filter-name>CsrfFilter</filter-name><filter-class>vn.edu.huy.filter.CsrfFilter_24162049</filter-class></filter>
<filter><filter-name>SiteMesh</filter-name><filter-class>org.sitemesh.config.ConfigurableSiteMeshFilter</filter-class></filter>
<filter-mapping><filter-name>EncodingFilter</filter-name><url-pattern>/*</url-pattern><dispatcher>REQUEST</dispatcher></filter-mapping>
<filter-mapping><filter-name>AuthenticationFilter</filter-name><url-pattern>/*</url-pattern><dispatcher>REQUEST</dispatcher></filter-mapping>
<filter-mapping><filter-name>AdminAuthorizationFilter</filter-name><url-pattern>/admin</url-pattern><url-pattern>/admin/*</url-pattern><dispatcher>REQUEST</dispatcher></filter-mapping>
<filter-mapping><filter-name>CsrfFilter</filter-name><url-pattern>/*</url-pattern><dispatcher>REQUEST</dispatcher></filter-mapping>
<filter-mapping><filter-name>SiteMesh</filter-name><url-pattern>/*</url-pattern><dispatcher>REQUEST</dispatcher></filter-mapping>
<servlet><servlet-name>HomeController</servlet-name><servlet-class>vn.edu.huy.controller.HomeController_24162049</servlet-class></servlet>
<servlet-mapping><servlet-name>HomeController</servlet-name><url-pattern>/home</url-pattern></servlet-mapping>
<servlet><servlet-name>ProductsController</servlet-name><servlet-class>vn.edu.huy.controller.ProductsController_24162049</servlet-class></servlet>
<servlet-mapping><servlet-name>ProductsController</servlet-name><url-pattern>/products</url-pattern></servlet-mapping>
<servlet><servlet-name>VideoController</servlet-name><servlet-class>vn.edu.huy.controller.VideoController_24162049</servlet-class></servlet>
<servlet-mapping><servlet-name>VideoController</servlet-name><url-pattern>/video/detail</url-pattern><url-pattern>/video/like</url-pattern><url-pattern>/video/share</url-pattern></servlet-mapping>
<servlet><servlet-name>CartController</servlet-name><servlet-class>vn.edu.huy.controller.CartController_24162049</servlet-class></servlet>
<servlet-mapping><servlet-name>CartController</servlet-name><url-pattern>/cart</url-pattern><url-pattern>/cart/add</url-pattern><url-pattern>/cart/update</url-pattern><url-pattern>/cart/remove</url-pattern></servlet-mapping>
<servlet><servlet-name>CheckoutController</servlet-name><servlet-class>vn.edu.huy.controller.CheckoutController_24162049</servlet-class></servlet>
<servlet-mapping><servlet-name>CheckoutController</servlet-name><url-pattern>/checkout</url-pattern></servlet-mapping>
<servlet><servlet-name>OrderController</servlet-name><servlet-class>vn.edu.huy.controller.OrderController_24162049</servlet-class></servlet>
<servlet-mapping><servlet-name>OrderController</servlet-name><url-pattern>/orders</url-pattern><url-pattern>/orders/detail</url-pattern></servlet-mapping>
<servlet><servlet-name>AuthController</servlet-name><servlet-class>vn.edu.huy.controller.AuthController_24162049</servlet-class></servlet>
<servlet-mapping><servlet-name>AuthController</servlet-name><url-pattern>/login</url-pattern><url-pattern>/register</url-pattern><url-pattern>/verify-otp</url-pattern><url-pattern>/resend-otp</url-pattern><url-pattern>/logout</url-pattern></servlet-mapping>
<servlet><servlet-name>admin.DashboardController</servlet-name><servlet-class>vn.edu.huy.controller.admin.DashboardController_24162049</servlet-class></servlet>
<servlet-mapping><servlet-name>admin.DashboardController</servlet-name><url-pattern>/admin</url-pattern></servlet-mapping>
<servlet><servlet-name>admin.UserController</servlet-name><servlet-class>vn.edu.huy.controller.admin.UserController_24162049</servlet-class></servlet>
<servlet-mapping><servlet-name>admin.UserController</servlet-name><url-pattern>/admin/users</url-pattern><url-pattern>/admin/users/create</url-pattern><url-pattern>/admin/users/detail</url-pattern><url-pattern>/admin/users/edit</url-pattern><url-pattern>/admin/users/delete</url-pattern></servlet-mapping>
<session-config><session-timeout>30</session-timeout><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
<welcome-file-list><welcome-file>home</welcome-file></welcome-file-list>
<error-page><error-code>403</error-code><location>/WEB-INF/views/errors/403.jsp</location></error-page>
<error-page><error-code>404</error-code><location>/WEB-INF/views/errors/404.jsp</location></error-page>
<error-page><error-code>405</error-code><location>/WEB-INF/views/errors/405.jsp</location></error-page>
<error-page><error-code>500</error-code><location>/WEB-INF/views/errors/500.jsp</location></error-page>
<error-page><exception-type>java.lang.Throwable</exception-type><location>/WEB-INF/views/errors/500.jsp</location></error-page>
</web-app>
